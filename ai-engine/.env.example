# AI SOC Engine — environment variables (copy to .env or export)
# These override ai-engine/config.yaml.

# Model backend: "ollama" (local LLM) or "offline" (deterministic rules only)
AI_SOC_BACKEND=ollama
MODEL_NAME=llama3
OLLAMA_HOST=http://ollama:11434

# LLM behaviour
AI_SOC_TIMEOUT_SECONDS=30
AI_SOC_RETRIES=1

# Confidence thresholds
AI_SOC_ESCALATE_MIN_CONFIDENCE=0.75
AI_SOC_CLOSE_MIN_CONFIDENCE=0.85

# Human approval (true = ESCALATE/CLOSE are held for analyst approval)
AI_SOC_HUMAN_APPROVAL=true

# Deduplication window (seconds)
AI_SOC_DEDUPE_TTL_SECONDS=300

# Prompt version (directory under ai-engine/prompts/)
AI_SOC_PROMPT_VERSION=v1

# TheHive
THEHIVE_URL=http://thehive:9000
THEHIVE_API_KEY=

# Logging
LOG_LEVEL=INFO
